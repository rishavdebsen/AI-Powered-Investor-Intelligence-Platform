# Local profile (default): no keys needed. Retrieval uses built-in TF-IDF and
# answers quote retrieved excerpts verbatim.
II_PROFILE=local
DATABASE_URL=sqlite:///./investor_intel.db

# LLM-grounded answers (optional): pick one provider.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# LLM_PROVIDER=azure-openai
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# Azure profile: PostgreSQL instead of SQLite.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/investor_intel

# Product analytics (optional): Mixpanel project token. Tracking is a no-op
# without it, so local dev and the demo keep working with no account.
# MIXPANEL_PROJECT_TOKEN=
# EU data-residency projects:
# MIXPANEL_API_HOST=api-eu.mixpanel.com


# Semantic / hybrid retrieval (optional): local sentence-transformers
# embeddings on CPU - no API keys, one-time model download. Requires
# `pip install 'investor-intel[semantic]'`.
# II_EMBEDDINGS_PROVIDER=sentence-transformers   # dense embeddings only
# II_EMBEDDINGS_PROVIDER=hybrid                  # TF-IDF + dense fused (recommended)
# II_SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
# II_HYBRID_TFIDF_WEIGHT=0.5                     # TF-IDF share of the hybrid score
