# ACR_NAME and IMAGE_TAG are substituted by .github/workflows/cd-aks.yml.
# Secrets (LLM keys, database URL) come from the `investor-intel-secrets`
# kubernetes secret, created out-of-band - never committed to this repo.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
  namespace: investor-intel
spec:
  replicas: 2
  selector:
    matchLabels: {app: api}
  template:
    metadata:
      labels: {app: api}
    spec:
      containers:
        - name: api
          image: ACR_NAME.azurecr.io/investor-intel-api:IMAGE_TAG
          ports: [{containerPort: 8000}]
          envFrom:
            - secretRef: {name: investor-intel-secrets}
          readinessProbe:
            httpGet: {path: /health, port: 8000}
          livenessProbe:
            httpGet: {path: /health, port: 8000}
---
apiVersion: v1
kind: Service
metadata:
  name: api
  namespace: investor-intel
spec:
  selector: {app: api}
  ports: [{port: 8000, targetPort: 8000}]
